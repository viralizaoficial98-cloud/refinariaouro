# URL pública canónica do site (sem barra final). Usada em canonical, Open Graph e sitemap.
VITE_SITE_URL=https://www.exemplo.ao

# Endpoint HTTPS que recebe o formulário de contacto (POST JSON). Se vazio, o formulário
# informa que o envio não está disponível — nunca simula sucesso.
VITE_CONTACT_ENDPOINT=

# Base da API do CMS/backoffice (ex.: https://api.exemplo.ao). Se vazia, o backoffice
# funciona apenas em modo de demonstração, sem persistência.
VITE_API_BASE_URL=

# NOTA: nunca colocar aqui segredos (chaves, palavras-passe). Todas as variáveis VITE_*
# são incorporadas no bundle público.
